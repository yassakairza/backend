# For local testing only with `vercel dev`.
# In production, set these in the Vercel dashboard instead (Project Settings > Environment Variables) --
# never commit your real values.

MONGODB_URI=mongodb+srv://yourUsername:yourPassword@yourcluster.xxxxx.mongodb.net/dndcharsheet?retryWrites=true&w=majority

# A long, random, secret string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this isn't set, a weak default is used and NO login session is secure -- always set a real one in Vercel.
JWT_SECRET=replace-with-a-long-random-string

